    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.4",
    "morgan": "^1.10.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "posthog-node": "^5.40.0",
