    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "start:workers": "node worker-entry.js",
    "dev": "nodemon server.js",
    "build": "node -e \"require('./server.js')\" --check 2>/dev/null || node --check server.js && echo backend syntax ok",
    "test": "cross-env SUPABASE_URL=http://localhost SUPABASE_ANON_KEY=dummy_key_must_be_20_chars node --test src/tests/invariants/*.test.js",
    "test:ci": "cross-env SUPABASE_URL=http://localhost SUPABASE_ANON_KEY=dummy_key_must_be_20_chars node --test src/tests/invariants/*.test.js > src/tests/logs/test-run.log 2>&1 || (node -e \"console.log(require('fs').readFileSync('src/tests/logs/test-run.log', 'utf8'))\" && exit 1)",
    "lint:syntax": "node --check server.js && find src -name '*.js' -exec node --check {} +"
  },
