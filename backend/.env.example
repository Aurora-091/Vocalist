# Aurora Backend — Railway Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets.

# ─── Core ───────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ─── Supabase ───────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── CORS (comma-separated allowed origins) ─────────────────
# Example: https://aurora-console.vercel.app,https://preview-*.vercel.app
CORS_ALLOWED_ORIGINS=

# ─── Twilio ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_REGION=us1
TWILIO_VOICE_BASE_URL=
TWILIO_SANDBOX_MODE=false

# ─── ElevenLabs ─────────────────────────────────────────────
ELEVENLABS_API_KEY=

# ─── Stripe ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Vapi (if used) ─────────────────────────────────────────
VAPI_WEBHOOK_SECRET=

# ─── Business Rules ─────────────────────────────────────────
CALLING_HOUR_START=9
CALLING_HOUR_END=19

# ─── Workers ────────────────────────────────────────────────
RUN_WORKERS=1

# ─── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
