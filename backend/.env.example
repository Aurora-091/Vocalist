# Aurora Backend — Railway Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets.

# ─── Core ───────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ─── Supabase ───────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret for token verification (from Supabase dashboard > Settings > API)
SUPABASE_JWT_SECRET=

# ─── CORS (comma-separated allowed origins) ─────────────────
# Example: https://weeber.ai,https://app.weeber.ai,https://admin.weeber.ai
CORS_ALLOWED_ORIGINS=

# ─── Twilio ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_REGION=us1
TWILIO_VOICE_BASE_URL=
TWILIO_SANDBOX_MODE=false

# ─── ElevenLabs ─────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=

# ─── Stripe ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Vapi (if used) ─────────────────────────────────────────
VAPI_WEBHOOK_SECRET=

# ─── Rate Limiting (optional — defaults shown) ──────────────
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=120

# ─── Workers ────────────────────────────────────────────────
RUN_WORKERS=0

# ─── Resend (transactional emails) ─────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=Weeber <hello@weeber.ai>
# Audience ID from Resend dashboard — required to save contacts for bulk campaigns
RESEND_AUDIENCE_ID=

# ─── URLs (used in emails) ──────────────────────────────────
FRONTEND_URL=https://weeber.ai
BACKEND_URL=https://api.weeber.ai

# ─── Shopify ────────────────────────────────────────────────
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
WEEBER_INTERNAL_SECRET=
WEEBERSH_INSTALL_URL=https://weebersh.com/api/auth

# ─── PostHog (server-side analytics queries) ────────────────
# Personal API Key from PostHog → Settings → Personal API Keys
POSTHOG_API_KEY=
# Project ID from PostHog → Settings → Project
POSTHOG_PROJECT_ID=
# PostHog host (defaults to https://us.i.posthog.com if empty)
POSTHOG_HOST=https://us.i.posthog.com

