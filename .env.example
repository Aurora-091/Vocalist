# Aurora Console — Frontend Environment Variables
# Copy to .env and fill in values

# ─── Supabase ───────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Backend API URL ────────────────────────────────────────
# Leave empty for development (uses Vite proxy)
# Set to Railway URL for production builds deployed to Vercel
# Example: https://aurora-api.up.railway.app
VITE_API_BASE_URL=

# ─── Admin Subdomain ───────────────────────────────────────
# Hostname that serves the admin panel (no protocol, no port)
# Production: admin.weeber.ai
# Local dev:  admin.localhost
VITE_ADMIN_HOST=admin.localhost

# ─── Demo Mode (optional, omit in production) ──────────────
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
