# Aurora Console — Frontend Environment Variables
# Copy to .env and fill in values

# ─── Supabase ───────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Backend API URL ────────────────────────────────────────
# Leave empty for development (uses Vite proxy)
# Set to Railway URL for production builds deployed to Vercel
# Example: https://aurora-api.up.railway.app
VITE_API_BASE_URL=

# ─── Admin Subdomain ───────────────────────────────────────
# Hostname that serves the admin panel (no protocol, no port)
# Production: admin.weeber.ai
# Local dev:  admin.localhost
VITE_ADMIN_HOST=admin.localhost

# ─── App Subdomain ────────────────────────────────────────
# Hostname that serves the authenticated app (dashboard, agents, etc.)
# Production: app.weeber.ai
# Local dev:  localhost (same origin in dev for simplicity)
VITE_APP_HOST=app.weeber.ai

# ─── Marketing Domain ─────────────────────────────────────
# Hostname that serves the public marketing site (waitlist, login, signup)
# Production: weeber.ai
# Local dev:  localhost
VITE_MARKETING_HOST=weeber.ai

# ─── Demo Mode (optional, omit in production) ──────────────
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=

# ─── Shopify OAuth (weebersh.com) ──────────────────────────
VITE_WEEBERSH_INSTALL_URL=https://weebersh.com/api/auth

# ─── Tracking & Analytics Fallbacks (optional) ─────────────
VITE_GA4_ID=
VITE_ADS_ID=
VITE_GTM_ID=
