# Weeber — Frontend Environment Variables
# Copy to .env and fill in values

# ─── Supabase ───────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Backend API URL ────────────────────────────────────────
# Leave empty for development (uses Vite proxy)
# Set to Railway URL for production builds deployed to Vercel
# Example: https://aurora-api.up.railway.app
VITE_API_BASE_URL=

# ─── Admin Subdomain ───────────────────────────────────────
# Hostname that serves the admin panel (no protocol, no port)
# Production: admin.weeber.ai
# Local dev:  admin.localhost
VITE_ADMIN_HOST=admin.localhost

# ─── Shopify OAuth (weebersh.com) ──────────────────────────
VITE_WEEBERSH_INSTALL_URL=https://weebersh.com/api/auth

# ─── Tracking & Analytics (optional) ─────────────────────────
VITE_GA4_ID=
VITE_ADS_ID=
VITE_GTM_ID=

# ─── PostHog (product analytics) ──────────────────────────
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ─── OAuth CSRF protection ─────────────────────────────────
# Must match OAUTH_STATE_SECRET set in Supabase edge function secrets
# Generate with: openssl rand -hex 32
# Example: https://aurora-api.up.railway.app
VITE_OAUTH_STATE_SECRET=

# ─── Sentry (error tracking) ──────────────────────────────
VITE_SENTRY_DSN=
# Optional: override auto-generated release name
VITE_SENTRY_RELEASE=
# Auth token for source map uploads (from sentry.io > Settings > Auth Tokens)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=weeber
SENTRY_PROJECT=vocalist
